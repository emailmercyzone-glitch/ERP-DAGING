APP_ENV=
BACKEND_ADAPTER=LOCAL_ONLY
API_BASE_URL=
STORE_ID=
STORE_NAME=
SUPABASE_ANON_KEY=
SUPABASE_URL=
GEMINI_API_KEY=
APP_URL=
# Optional comma-separated browser origins allowed to call the API. Capacitor origins are allowed by default.
# Add the hosted PWA origin here if it differs from APP_URL; no hosting provider is assumed.
CORS_ORIGINS=

# Google OAuth 2.0 Web Client ID from Google Cloud Console.
# Configure localhost as an authorized JavaScript origin for development,
# then add the actual HTTPS origin after the production domain is selected.
GOOGLE_CLIENT_ID=

# Generate a unique random value with at least 32 characters.
# Server only: never prefix this secret with VITE_.
ERP_AUTH_SESSION_SECRET=

# Server-side bootstrap membership registry. Empty means no ERP account is authorized.
# googleSub is the immutable "sub" claim from a verified Google ID token.
# Supported roles: OWNER, ADMIN, SALES.
# Set deviceIds on every active membership. Missing/empty deviceIds deny server sync.
# Example only; replace placeholders with real Google subject, Store ID, and Device ID.
ERP_AUTH_MEMBERS_JSON='[{"googleSub":"GOOGLE_SUBJECT_FROM_ID_TOKEN","storeId":"ERP_DAGING","role":"OWNER","active":true,"deviceIds":["DEVICE_ID_FROM_OWNER_STATUS"]}]'

# Optional Google Apps Script sync gateway.
# These values are server-only; never use VITE_ prefixes or store them in PWA config.
GAS_WEB_APP_URL=
GAS_SYNC_SHARED_SECRET=
GAS_GATEWAY_HMAC_SECRET=

# RSA private key used only by the server to sign device-bound 72-hour offline leases.
# Generate an RSA 2048-bit keypair; keep the private key secret and inject it at runtime.
# Public key must be supplied to the PWA build as VITE_ERP_OFFLINE_LEASE_PUBLIC_KEY.
ERP_OFFLINE_LEASE_PRIVATE_KEY=
# Public key is safe to embed in the PWA bundle; paste the matching PEM public key here at build time.
VITE_ERP_OFFLINE_LEASE_PUBLIC_KEY=


# Owner Google Drive backup gateway. Server-only; never use VITE_ prefixes.
# The refresh token must belong to GOOGLE_DRIVE_OWNER_EMAIL and include Drive file access.
# Run `bun run setup:drive-folder` locally to create/reuse the app-owned folder and print its ID.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_OWNER_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
